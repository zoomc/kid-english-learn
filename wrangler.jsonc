{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 纯静态站：只有静态资源，没有 Worker 代码，不产生任何付费资源
  "name": "kid-english-learn",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // 国内访问用自定义域名（workers.dev 在大陆打不开）；Cloudflare 自动建 DNS 记录和证书
  "routes": [{ "pattern": "english.zoomlab.top", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
