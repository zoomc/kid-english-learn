{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 纯静态站：只有静态资源，没有 Worker 代码，不产生任何付费资源
  "name": "kid-english-learn",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
